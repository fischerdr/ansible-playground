---
# Ansible Lint Configuration
# Supports structured multi-line Jinja2 expressions and enterprise standards

profile: production

skip_list:
  # YAML Formatting
  - yaml[line-length]
  - yaml[octal-values]

  # Variable Naming
  - var-naming[no-role-prefix]
  - var-naming[pattern]

  # Module Usage
  - command-instead-of-module

  # Jinja2 Templates
  - name[template]
  - jinja[spacing]

# Enable strict mode for better error detection
# strict: true

# Optionally enable offline mode if you don't want to check for updates
# offline: true

# Exclude certain paths from linting
exclude_paths:
  - .cache/
  - .tox/
  - .venv/
  - tmp/
  - collections/
  - Build-EE/
  - .github/
  - .molecule/
  - tests/
# Enable specific rules (these support our formatting standards)
enable_list:
  - fqcn
  - yaml[truthy]
  - no-log-password
  - yaml[indentation]
  - no-same-owner
# Set warnings for rules that should be followed but aren't critical
warn_list:
  - experimental
  - role-name
  - jinja[spacing]

# Configure specific rules (if needed)
# Note: Most rule configuration is handled via skip_list and enable_list above
# Uncomment and adjust as needed for your project
#
# rules:
#   yaml[line-length]:
#     max: 160

