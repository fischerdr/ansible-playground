```

### Role Inclusion Pattern

```yaml
- name: "Include common setup tasks"
  ansible.builtin.include_role:
    name: common
    tasks_from: setup
  vars:
    setup_type: "application"
    setup_environment: "{{ target_environment }}"
  tags: [setup, common]
```

## Error Handling and Validation

### Comprehensive Error Handling

```yaml
- name: "Deploy application with comprehensive error handling"
  block:
    - name: "Pre-deployment validation checks"
      ansible.builtin.include_tasks: validate_deployment.yml
      
    - name: "Execute deployment process"
      ansible.builtin.include_tasks: deploy_application.yml
      
    - name: "Post-deployment verification"
      ansible.builtin.include_tasks: verify_deployment.yml
      
  rescue:
    - name: "Capture failure details"
      ansible.builtin.set_fact:
        deployment_failure_time: "{{ ansible_date_time.iso8601 }}"
        deployment_failure_host: "{{ inventory_hostname }}"
        
    - name: "Execute rollback procedures"
      ansible.builtin.include_tasks: rollback_deployment.yml
      when: enable_automatic_rollback | default(true)
      
    - name: "Send failure notification"
      ansible.builtin.include_tasks: notify_failure.yml
      
  always:
    - name: "Clean up temporary resources"
      ansible.builtin.include_tasks: cleanup_resources.yml
      
    - name: "Update deployment status in tracking system"
      ansible.builtin.uri:
        url: "{{ tracking_system_url }}/deployments/{{ deployment_id }}/status"
        method: PUT
        body_format: json
        body:
          status: "{{ 'FAILED' if deployment_failure_time is defined else 'SUCCESS' }}"
          timestamp: "{{ ansible_date_time.iso8601 }}"
          host: "{{ inventory_hostname }}"
        validate_certs: true
      when: tracking_system_url is defined
      
  tags: [deployment, critical]
```

## LLM-Specific Enhancements

### Template Comments for LLM Context

```yaml
# LLM Context: This task configures nginx virtual host
# Expected Input: domain_name (string), ssl_enabled (boolean)
# Expected Output: nginx configuration file, restart handler triggered
# Dependencies: nginx package installed, ssl certificates available if ssl_enabled
- name: "Configure nginx virtual host for {{ domain_name }}"
  ansible.builtin.template:
    src: nginx_vhost.j2
    dest: "/etc/nginx/sites-available/{{ domain_name }}"
    owner: root
    group: root
    mode: '0644'
  notify: restart_nginx
  tags: [nginx, configuration, webserver]
```

### Explicit State Management

```yaml
# Always include explicit state tracking for complex operations
- name: "Track operation state for monitoring and recovery"
  ansible.builtin.set_fact:
    operation_states: "{{ operation_states | default({}) | combine({
      'current_step': 'database_migration',
      'step_start_time': ansible_date_time.iso8601,
      'steps_completed': (operation_states.steps_completed | default([])) + ['backup_created']
    }) }}"
  tags: [state_tracking, monitoring]
```

### Validation Patterns

```yaml
# Include comprehensive input validation
- name: "Validate configuration parameters meet requirements"
  ansible.builtin.assert:
    that:
      - cpu_limit is number
      - cpu_limit >= 0.1
      - cpu_limit <= 8.0
      - memory_limit is match('^[0-9]+[MG]i?$')
      - port_number is number
      - port_number >= 1024
      - port_number <= 65535
    fail_msg: |
      Configuration validation failed. Requirements:
      - cpu_limit: number between 0.1 and 8.0 (provided: {{ cpu_limit }})
      - memory_limit: string in format like '512Mi' or '2Gi' (provided: {{ memory_limit }})
      - port_number: integer between 1024 and 65535 (provided: {{ port_number }})
    success_msg: "All configuration parameters validated successfully"
  tags: [validation, always]
```

## Testing and Debugging

### Built-in Testing Tasks

```yaml
- name: "Execute built-in service health checks"
  block:
    - name: "Test service endpoint availability"
      ansible.builtin.uri:
        url: "http://{{ ansible_default_ipv4.address }}:{{ service_port }}/health"
        method: GET
        timeout: 10
        status_code: [200, 204]
      register: health_check_result
      retries: 3
      delay: 5
      
    - name: "Validate service configuration"
      ansible.builtin.command:
        cmd: "{{ service_name }} --validate-config"
      register: config_validation
      changed_when: false
      
    - name: "Record successful validation"
      ansible.builtin.debug:
        msg: "Service {{ service_name }} passed all health checks"
        
  rescue:
    - name: "Log detailed failure information for debugging"
      ansible.builtin.debug:
        msg: |
          Health check failed for {{ service_name }}:
          - Health endpoint: {{ health_check_result.msg | default('N/A') }}
          - Config validation: {{ config_validation.stderr | default('N/A') }}
          - Troubleshooting: Check logs at /var/log/{{ service_name }}/
        
  tags: [testing, health_check, post_deployment]
```

