{
  "name": "Portworx Upgrade - Preflight Check",
  "description": "Run preflight validation only - verifies cluster is ready for upgrade without making changes",
  "job_type": "run",
  "inventory": null,
  "project": null,
  "playbook": "playbooks/px_upgrade.yml",
  "scm_branch": "",
  "forks": 0,
  "limit": "",
  "verbosity": 1,
  "extra_vars": "---\nportworx_target_version: \"\"\nportworx_detailed_logging: true",
  "job_tags": "preflight",
  "force_handlers": false,
  "skip_tags": "",
  "start_at_task": "",
  "timeout": 0,
  "use_fact_cache": false,
  "host_config_key": "",
  "ask_scm_branch_on_launch": false,
  "ask_diff_mode_on_launch": false,
  "ask_variables_on_launch": true,
  "ask_limit_on_launch": false,
  "ask_tags_on_launch": false,
  "ask_skip_tags_on_launch": false,
  "ask_job_type_on_launch": false,
  "ask_verbosity_on_launch": false,
  "ask_inventory_on_launch": false,
  "ask_credential_on_launch": false,
  "survey_enabled": true,
  "become_enabled": false,
  "diff_mode": false,
  "allow_simultaneous": true,
  "custom_virtualenv": null,
  "job_slice_count": 1,
  "webhook_service": "",
  "webhook_credential": null,
  "prevent_instance_group_fallback": false,
  "survey_spec": {
    "name": "Preflight Check Parameters",
    "description": "Configure parameters for preflight validation",
    "spec": [
      {
        "question_name": "Target Portworx Version",
        "question_description": "Target Portworx OCI version to validate against (e.g., 3.5.0)",
        "required": true,
        "type": "text",
        "variable": "portworx_target_version",
        "min": 0,
        "max": 1024,
        "default": "",
        "choices": "",
        "new_question": true
      },
      {
        "question_name": "Cluster Name",
        "question_description": "Name of the cluster for reporting",
        "required": false,
        "type": "text",
        "variable": "portworx_cluster_name",
        "min": 0,
        "max": 256,
        "default": "",
        "choices": "",
        "new_question": true
      }
    ]
  }
}
