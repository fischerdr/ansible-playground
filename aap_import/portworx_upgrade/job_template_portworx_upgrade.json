{
  "job_templates": [
    {
      "name": "Portworx Cluster Upgrade",
      "description": "Automated Portworx cluster upgrade with comprehensive validation, monitoring, and reporting",
      "job_type": "run",
      "inventory": null,
      "playbook": "playbooks/px_upgrade.yml",
      "scm_branch": "",
      "forks": 0,
      "limit": "",
      "verbosity": 1,
      "extra_vars": "---\nportworx_target_version: \"\"\nportworx_impatient_mode: false\nportworx_detailed_logging: true",
      "job_tags": "",
      "force_handlers": false,
      "skip_tags": "",
      "start_at_task": "",
      "timeout": 0,
      "use_fact_cache": false,
      "host_config_key": "",
      "ask_scm_branch_on_launch": false,
      "ask_diff_mode_on_launch": false,
      "ask_variables_on_launch": true,
      "ask_limit_on_launch": false,
      "ask_tags_on_launch": true,
      "ask_skip_tags_on_launch": false,
      "ask_job_type_on_launch": false,
      "ask_verbosity_on_launch": false,
      "ask_inventory_on_launch": true,
      "ask_credential_on_launch": false,
      "ask_execution_environment_on_launch": false,
      "ask_labels_on_launch": false,
      "ask_forks_on_launch": false,
      "ask_job_slice_count_on_launch": false,
      "ask_timeout_on_launch": false,
      "ask_instance_groups_on_launch": false,
      "survey_enabled": true,
      "become_enabled": false,
      "diff_mode": false,
      "allow_simultaneous": false,
      "job_slice_count": 1,
      "webhook_service": "",
      "webhook_credential": null,
      "prevent_instance_group_fallback": false,
      "opa_query_path": "",
      "project": {
        "organization": {
          "name": "Default",
          "type": "organization"
        },
        "name": "Portworx Automation",
        "type": "project"
      },
      "execution_environment": {
        "name": "Portworx EE",
        "type": "execution_environment"
      },
      "related": {
        "labels": [],
        "credentials": [],
        "schedules": [],
        "notification_templates_started": [],
        "notification_templates_success": [],
        "notification_templates_error": [],
        "survey_spec": {
          "name": "Portworx Upgrade Parameters",
          "description": "Configure parameters for Portworx cluster upgrade",
          "spec": [
            {
              "question_name": "Target Portworx Version",
              "question_description": "Target Portworx OCI version (e.g., 3.5.0)",
              "required": true,
              "type": "text",
              "variable": "portworx_target_version",
              "min": 0,
              "max": 1024,
              "default": "",
              "choices": "",
              "new_question": true
            },
            {
              "question_name": "Cluster Name",
              "question_description": "Name of the cluster being upgraded (for reporting)",
              "required": false,
              "type": "text",
              "variable": "portworx_cluster_name",
              "min": 0,
              "max": 256,
              "default": "",
              "choices": "",
              "new_question": true
            },
            {
              "question_name": "Enable Impatient Mode",
              "question_description": "Accelerate storageless node upgrades via batch deletion",
              "required": true,
              "type": "multiplechoice",
              "variable": "portworx_impatient_mode",
              "min": 0,
              "max": 1024,
              "default": "false",
              "choices": "false\ntrue",
              "new_question": true
            },
            {
              "question_name": "Impatient Mode Batch Size",
              "question_description": "Number of storageless pods to delete per batch (5-7 recommended)",
              "required": false,
              "type": "integer",
              "variable": "portworx_impatient_batch_size",
              "min": 1,
              "max": 10,
              "default": "5",
              "choices": "",
              "new_question": true
            },
            {
              "question_name": "Skip Operator Upgrade",
              "question_description": "Skip the operator upgrade phase (if already upgraded)",
              "required": false,
              "type": "multiplechoice",
              "variable": "portworx_skip_operator_upgrade",
              "min": 0,
              "max": 1024,
              "default": "false",
              "choices": "false\ntrue",
              "new_question": true
            },
            {
              "question_name": "Detailed Logging",
              "question_description": "Enable detailed logging for troubleshooting",
              "required": false,
              "type": "multiplechoice",
              "variable": "portworx_detailed_logging",
              "min": 0,
              "max": 1024,
              "default": "true",
              "choices": "true\nfalse",
              "new_question": true
            },
            {
              "question_name": "Work Directory",
              "question_description": "Base directory for reports and logs",
              "required": false,
              "type": "text",
              "variable": "portworx_work_dir",
              "min": 0,
              "max": 512,
              "default": "/tmp/ansible-workdir",
              "choices": "",
              "new_question": true
            }
          ]
        }
      },
      "natural_key": {
        "organization": {
          "name": "Default",
          "type": "organization"
        },
        "name": "Portworx Cluster Upgrade",
        "type": "job_template"
      }
    }
  ]
}
