{
  "name": "Portworx Cluster Upgrade - Impatient Mode",
  "description": "Automated Portworx upgrade with impatient mode enabled for accelerated storageless node upgrades",
  "job_type": "run",
  "inventory": null,
  "project": null,
  "playbook": "playbooks/px_upgrade.yml",
  "scm_branch": "",
  "forks": 0,
  "limit": "",
  "verbosity": 1,
  "extra_vars": "---\nportworx_target_version: \"\"\nportworx_impatient_mode: true\nportworx_impatient_batch_size: 7\nportworx_detailed_logging: true",
  "job_tags": "",
  "force_handlers": false,
  "skip_tags": "",
  "start_at_task": "",
  "timeout": 0,
  "use_fact_cache": false,
  "host_config_key": "",
  "ask_scm_branch_on_launch": false,
  "ask_diff_mode_on_launch": false,
  "ask_variables_on_launch": true,
  "ask_limit_on_launch": false,
  "ask_tags_on_launch": false,
  "ask_skip_tags_on_launch": false,
  "ask_job_type_on_launch": false,
  "ask_verbosity_on_launch": false,
  "ask_inventory_on_launch": false,
  "ask_credential_on_launch": false,
  "survey_enabled": true,
  "become_enabled": false,
  "diff_mode": false,
  "allow_simultaneous": false,
  "custom_virtualenv": null,
  "job_slice_count": 1,
  "webhook_service": "",
  "webhook_credential": null,
  "prevent_instance_group_fallback": false,
  "survey_spec": {
    "name": "Impatient Mode Upgrade Parameters",
    "description": "Configure parameters for accelerated Portworx upgrade",
    "spec": [
      {
        "question_name": "Target Portworx Version",
        "question_description": "Target Portworx OCI version (e.g., 3.5.0)",
        "required": true,
        "type": "text",
        "variable": "portworx_target_version",
        "min": 0,
        "max": 1024,
        "default": "",
        "choices": "",
        "new_question": true
      },
      {
        "question_name": "Cluster Name",
        "question_description": "Name of the cluster being upgraded",
        "required": false,
        "type": "text",
        "variable": "portworx_cluster_name",
        "min": 0,
        "max": 256,
        "default": "",
        "choices": "",
        "new_question": true
      },
      {
        "question_name": "Batch Size",
        "question_description": "Number of storageless pods to delete per batch (5-10 recommended)",
        "required": false,
        "type": "integer",
        "variable": "portworx_impatient_batch_size",
        "min": 3,
        "max": 15,
        "default": "7",
        "choices": "",
        "new_question": true
      },
      {
        "question_name": "Skip Operator Upgrade",
        "question_description": "Skip the operator upgrade phase",
        "required": false,
        "type": "multiplechoice",
        "variable": "portworx_skip_operator_upgrade",
        "min": 0,
        "max": 1024,
        "default": "false",
        "choices": "false\ntrue",
        "new_question": true
      }
    ]
  }
}
