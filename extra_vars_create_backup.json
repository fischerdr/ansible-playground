{
  "px_backup_api_url": "https://px-backup.example.com",
  "org_id": "default",
  "backup_name": "prod-app-backup",
  "cluster_name": "prod-cluster",
  "backup_location_name": "s3-backup-location",
  "validate_certs": true,
  "namespaces": [
    "app-namespace",
    "database-namespace"
  ],
  "backup_type": "Normal",
