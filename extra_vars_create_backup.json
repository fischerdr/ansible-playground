    "deployments",
    "statefulsets",
    "configmaps",
    "secrets"
  ],
  "ns_label_selectors": "app=myapp,environment=production",
  "backup_object_type": {
    "type": "All"
  },
  "labels": {
    "environment": "production",
    "application": "myapp",
    "team": "devops"
  }
}
