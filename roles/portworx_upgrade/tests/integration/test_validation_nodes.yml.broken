---
# Integration tests for node statistics validation logic
# Tests node counting by type and status from pxctl status output

- name: Test Node Statistics Validation Logic
  hosts: localhost
  gather_facts: false
  vars:
    portworx_target_version: "3.0.0"

  tasks:
    # ==========================================
    # POSITIVE TEST CASE - All Nodes Healthy
    # ==========================================

    - name: Test Case 1 - All nodes online, correct version
      block:
        - name: Set mock pxctl status output (healthy)
          ansible.builtin.set_fact:
            mock_pxctl_status:
              stdout_lines:
                - "Status: PX is operational"
                - "Cluster Summary"
                - "        Cluster ID: px-cluster-123"
                - "        Cluster UUID: a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                - "        Scheduler: kubernetes"
                - "        Total nodes: 5"
                - ""
                - "Node Details:"
                - "IP              ID                                      SchedulerNodeName   Storage Used/Capacity  Status  Version         Kernel          OS"
                - "10.0.1.1        node1-uuid-123                          worker-node-1       true    100 GiB/500 GiB     Online  3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.2        node2-uuid-456                          worker-node-2       true    150 GiB/500 GiB     Online  3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.3        node3-uuid-789                          worker-node-3       true    200 GiB/500 GiB     Online  3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.4        node4-uuid-abc                          worker-node-4       false   N/A N/A             Online  3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.5        node5-uuid-def                          worker-node-5       false   N/A N/A             Online  3.0.0           5.14.0-1       RHEL 8.5"

        - name: Count nodes by type and status
          ansible.builtin.set_fact:
            test_total_nodes: "{{ mock_pxctl_status.stdout_lines | select('match', '^[0-9]+\\.[0-9]+') | list | length }}"
            test_storage_nodes: "{{ mock_pxctl_status.stdout_lines | select('match', '^[0-9]+\\.[0-9]+') | select('search', '\\s+true\\s+') | list | length }}"
            test_storageless_nodes: "{{ mock_pxctl_status.stdout_lines | select('match', '^[0-9]+\\.[0-9]+') | select('search', '\\s+false\\s+') | list | length }}"
            test_online_nodes: "{{ mock_pxctl_status.stdout_lines | select('match', '^[0-9]+\\.[0-9]+') | select('search', '\\s+Online\\s+') | list | length }}"
            test_wrong_version: "{{ mock_pxctl_status.stdout_lines | select('match', '^[0-9]+\\.[0-9]+') | reject('search', portworx_target_version) | list | length }}"

        - name: Verify results - Test Case 1
          ansible.builtin.assert:
            that:
              - test_total_nodes | int == 5
              - test_storage_nodes | int == 3
              - test_storageless_nodes | int == 2
              - test_online_nodes | int == 5
              - test_wrong_version | int == 0
            success_msg: "PASS: Test Case 1 - All nodes healthy and correct version"
            fail_msg: "FAIL: Test Case 1 - Node counting incorrect"

    # ==========================================
    # NEGATIVE TEST CASE - Offline Nodes
    # ==========================================

    - name: Test Case 2 - Nodes offline
      block:
        - name: Set mock pxctl status output (offline nodes)
          ansible.builtin.set_fact:
            mock_pxctl_status:
              stdout_lines:
                - "IP              ID                                      SchedulerNodeName   Storage Used/Capacity  Status   Version         Kernel          OS"
                - "10.0.1.1        node1-uuid-123                          worker-node-1       true    100 GiB/500 GiB     Online   3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.2        node2-uuid-456                          worker-node-2       true    150 GiB/500 GiB     Offline  3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.3        node3-uuid-789                          worker-node-3       true    200 GiB/500 GiB     Online   3.0.0           5.14.0-1       RHEL 8.5"

        - name: Count nodes by status
          ansible.builtin.set_fact:
            test_total_nodes:
            {{ mock_pxctl_status.stdout_lines |
               select('match', '^[0-9]+\\.[0-9]+') |
               list |
               length }}
            test_online_nodes: >-
            {{ mock_pxctl_status.stdout_lines |
               select('match', '^[0-9]+\\.[0-9]+') |
               select('search', '\\s+Online\\s+') |
               list |
               length }}
            test_offline_nodes: >-
            {{ mock_pxctl_status.stdout_lines |
               select('match', '^[0-9]+\\.[0-9]+') |
               select('search', '\\s+Offline\\s+') |
               list |
               length }}

        - name: Verify results - Test Case 2
          ansible.builtin.assert:
            that:
              - test_total_nodes | int == 3
              - test_online_nodes | int == 2
              - test_offline_nodes | int == 1
            success_msg: "PASS: Test Case 2 - Offline nodes detected"
            fail_msg: "FAIL: Test Case 2 - Offline node detection failed"

    # ==========================================
    # NEGATIVE TEST CASE - Degraded Nodes
    # ==========================================

    - name: Test Case 3 - Nodes degraded
      block:
        - name: Set mock pxctl status output (degraded)
          ansible.builtin.set_fact:
            mock_pxctl_status:
              stdout_lines:
                - "IP              ID                                      SchedulerNodeName   Storage Used/Capacity  Status    Version         Kernel          OS"
                - "10.0.1.1        node1-uuid-123                          worker-node-1       true    100 GiB/500 GiB     Online    3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.2        node2-uuid-456                          worker-node-2       true    150 GiB/500 GiB     Degraded  3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.3        node3-uuid-789                          worker-node-3       true    200 GiB/500 GiB     Degraded  3.0.0           5.14.0-1       RHEL 8.5"

        - name: Count degraded nodes
          ansible.builtin.set_fact:
            test_degraded_nodes: >-
            {{ mock_pxctl_status.stdout_lines |
               select('match', '^[0-9]+\\.[0-9]+') |
               select('search', '\\s+Degraded\\s+') |
               list |
               length }}

        - name: Verify results - Test Case 3
          ansible.builtin.assert:
            that:
              - test_degraded_nodes | int == 2
            success_msg: "PASS: Test Case 3 - Degraded nodes detected"
            fail_msg: "FAIL: Test Case 3 - Degraded node detection failed"

    # ==========================================
    # NEGATIVE TEST CASE - Wrong Version
    # ==========================================

    - name: Test Case 4 - Nodes on wrong version
      block:
        - name: Set mock pxctl status output (version mismatch)
          ansible.builtin.set_fact:
            mock_pxctl_status:
              stdout_lines:
                - "IP              ID                                      SchedulerNodeName   Storage Used/Capacity  Status  Version         Kernel          OS"
                - "10.0.1.1        node1-uuid-123                          worker-node-1       true    100 GiB/500 GiB     Online  3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.2        node2-uuid-456                          worker-node-2       true    150 GiB/500 GiB     Online  2.13.8          5.14.0-1       RHEL 8.5"
                - "10.0.1.3        node3-uuid-789                          worker-node-3       true    200 GiB/500 GiB     Online  2.13.8          5.14.0-1       RHEL 8.5"
                - "10.0.1.4        node4-uuid-abc                          worker-node-4       false   N/A N/A             Online  3.0.0           5.14.0-1       RHEL 8.5"

        - name: Count version consistency
          ansible.builtin.set_fact:
            test_total_nodes:
            {{ mock_pxctl_status.stdout_lines |
               select('match', '^[0-9]+\\.[0-9]+') |
               list |
               length }}
            test_wrong_version: >-
            {{ mock_pxctl_status.stdout_lines |
               select('match', '^[0-9]+\\.[0-9]+') |
               reject('search', portworx_target_version) |
               list |
               length }}

        - name: Verify results - Test Case 4
          ansible.builtin.assert:
            that:
              - test_total_nodes | int == 4
              - test_wrong_version | int == 2
            success_msg: "PASS: Test Case 4 - Version mismatch detected"
            fail_msg: "FAIL: Test Case 4 - Version detection failed"

    # ==========================================
    # EDGE CASE - Large Cluster
    # ==========================================

    - name: Test Case 5 - Large cluster (scalability test)
      block:
        - name: Generate large cluster data
          ansible.builtin.set_fact:
            mock_pxctl_status:
              stdout_lines: >-
                {{ ['IP              ID                                      SchedulerNodeName   Storage Used/Capacity  Status  Version         Kernel          OS'] +
                   (range(1, 51) | map('regex_replace', '^(.*)$', '10.0.1.\1        node\1-uuid-xxx                          worker-node-\1       true    100 GiB/500 GiB     Online  3.0.0           5.14.0-1       RHEL 8.5') | list) +
                   (range(51, 301) | map('regex_replace', '^(.*)$', '10.0.2.\1        node\1-uuid-xxx                          worker-node-\1       false   N/A N/A             Online  3.0.0           5.14.0-1       RHEL 8.5') | list) }}

        - name: Count large cluster nodes
          ansible.builtin.set_fact:
            test_total_nodes:
            {{ mock_pxctl_status.stdout_lines |
               select('match', '^[0-9]+\\.[0-9]+') |
               list |
               length }}
            test_storage_nodes: >-
            {{ mock_pxctl_status.stdout_lines |
               select('match', '^[0-9]+\\.[0-9]+') |
               select('search', '\\s+true\\s+') |
               list |
               length }}
            test_storageless_nodes: >-
            {{ mock_pxctl_status.stdout_lines |
               select('match', '^[0-9]+\\.[0-9]+') |
               select('search', '\\s+false\\s+') |
               list |
               length }}

        - name: Verify results - Test Case 5
          ansible.builtin.assert:
            that:
              - test_total_nodes | int == 300
              - test_storage_nodes | int == 50
              - test_storageless_nodes | int == 250
            success_msg: "PASS: Test Case 5 - Large cluster (300 nodes) handled efficiently"
            fail_msg: "FAIL: Test Case 5 - Large cluster counting failed"

    # ==========================================
    # EDGE CASE - Empty Output
    # ==========================================

    - name: Test Case 6 - Empty pxctl status (no nodes)
      block:
        - name: Set empty pxctl status
          ansible.builtin.set_fact:
            mock_pxctl_status:
              stdout_lines:
                - "Status: PX is operational"
                - "IP              ID                                      SchedulerNodeName   Storage Used/Capacity  Status  Version         Kernel          OS"

        - name: Count nodes
          ansible.builtin.set_fact:
            test_total_nodes:
            {{ mock_pxctl_status.stdout_lines |
               select('match', '^[0-9]+\\.[0-9]+') |
               list |
               length }}

        - name: Verify results - Test Case 6
          ansible.builtin.assert:
            that:
              - test_total_nodes | int == 0
            success_msg: "PASS: Test Case 6 - Empty output handled"
            fail_msg: "FAIL: Test Case 6 - Empty handling failed"

    # ==========================================
    # POSITIVE TEST CASE - Mixed Cluster
    # ==========================================

    - name: Test Case 7 - Realistic mixed cluster state
      block:
        - name: Set mock pxctl status output (realistic)
          ansible.builtin.set_fact:
            mock_pxctl_status:
              stdout_lines:
                - "IP              ID                                      SchedulerNodeName   Storage Used/Capacity  Status    Version         Kernel          OS"
                - "10.0.1.1        node1-uuid-123                          storage-node-1      true    450 GiB/500 GiB     Online    3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.2        node2-uuid-456                          storage-node-2      true    480 GiB/500 GiB     Online    3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.3        node3-uuid-789                          storage-node-3      true    420 GiB/500 GiB     Online    3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.4        node4-uuid-abc                          worker-node-1       false   N/A N/A             Online    3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.5        node5-uuid-def                          worker-node-2       false   N/A N/A             Online    3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.6        node6-uuid-ghi                          worker-node-3       false   N/A N/A             Online    3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.7        node7-uuid-jkl                          worker-node-4       false   N/A N/A             Online    3.0.0           5.14.0-1       RHEL 8.5"
                - "10.0.1.8        node8-uuid-mno                          worker-node-5       false   N/A N/A             Online    3.0.0           5.14.0-1       RHEL 8.5"

        - name: Count all node statistics
          ansible.builtin.set_fact:
            test_total_nodes:
            {{ mock_pxctl_status.stdout_lines |
               select('match', '^[0-9]+\\.[0-9]+') |
               list |
               length }}
            test_storage_nodes: >-
            {{ mock_pxctl_status.stdout_lines |
               select('match', '^[0-9]+\\.[0-9]+') |
               select('search', '\\s+true\\s+') |
               list |
               length }}
            test_storageless_nodes: >-
            {{ mock_pxctl_status.stdout_lines |
               select('match', '^[0-9]+\\.[0-9]+') |
               select('search', '\\s+false\\s+') |
               list |
               length }}
            test_online_nodes: >-
            {{ mock_pxctl_status.stdout_lines |
               select('match', '^[0-9]+\\.[0-9]+') |
               select('search', '\\s+Online\\s+') |
               list |
               length }}

        - name: Verify results - Test Case 7
          ansible.builtin.assert:
            that:
              - test_total_nodes | int == 8
              - test_storage_nodes | int == 3
              - test_storageless_nodes | int == 5
              - test_online_nodes | int == 8
              - (test_storage_nodes | int) + (test_storageless_nodes | int) == (test_total_nodes | int)
            success_msg: "PASS: Test Case 7 - Realistic mixed cluster validated"
            fail_msg: "FAIL: Test Case 7 - Mixed cluster validation failed"

    - name: All node statistics validation tests passed
      ansible.builtin.debug:
        msg: "✅ All node statistics validation tests PASSED"
